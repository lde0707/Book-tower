--- !u!114 &8469078198528813651
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8101792335703101370}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3ca32241d5e56804fa013af17f42ff11, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BookTower.UI.ReadableNote
  id: 1A.Book.Scale
  title: "\uC791\uC740 \uBAB8, \uD070 \uADF8\uB9BC\uC790"
  pages:
  - "\uB4F1 \uC55E\uC758 \uC624\uB9BC\uC744 \uC9C1\uC811 \uC7A1\uC544 \uC6C0\uC9C1\uC5EC
    \uBCF4\uC790. \uB4F1\uC5D0 \uAC00\uAE4C\uC6B0\uBA74 \uADF8\uB9BC\uC790\uAC00
    \uCEE4\uC9C0\uACE0, \uBCBD\uC5D0 \uAC00\uAE4C\uC6B0\uBA74 \uC791\uC544\uC9C4\uB2E4."
  - "\uC88C\uD074\uB9AD\uC744 \uB204\uB978 \uCC44 \uB04C\uAC70\uB098 F\uB85C \uC7A1\uACE0
    \uB2E4\uC2DC F\uB85C \uB193\uB294\uB2E4. \uADC0\uB97C \uC7A1\uC740 \uCC44 \uD720
    \uB610\uB294 \uC6B0\uD074\uB9AD\uC744 \uB204\uB974\uBA74 \uC55E\uB4A4\uAC00 \uBC14\uB010\uB2E4."
  - "\uD1A0\uB07C \uBAB8\uD1B5\uACFC \uADC0\uC758 \uD06C\uAE30\uBFD0 \uC544\uB2C8\uB77C
    \uC606\uC73C\uB85C \uC5B4\uAE0B\uB09C \uC704\uCE58\uB3C4 \uB9DE\uCD98\uB2E4.
    \uC190\uC744 \uB193\uACE0 \uC2E4\uC81C \uADF8\uB9BC\uC790\uAC00 \uBCBD\uC758
    \uC120\uC5D0 \uB4E4\uC5B4\uC624\uB294\uC9C0 \uC0B4\uD3B4\uBCF4\uC790."
